{
  "schema_version": 1,
  "recipe": "b1_tv_joint_v1",
  "sigma_d": 9.0,
  "noise_threshold": 0.32,
  "block_size": 256,
  "bins": [8, 4, 4],
  "axis_order": ["rho", "stick", "ball"],
